{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/components/ui/*": ["../../packages/ui/src/components/*"],
      "@/*": ["./src/*", "../web/src/*"],
      "@cubeforge/hardware-hal": ["./src/hardware-hal-override.ts"]
    }
  },
  "include": ["src", "../web/src"],
  // web/src/main.tsx is the PWA-only entry (it imports virtual:pwa-register,
  // a module only vite-plugin-pwa provides). The desktop app has its own
  // src/main.tsx entry — compiling the web one here would fail on that
  // virtual import.
  "exclude": ["../web/src/main.tsx"]
}
