{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/components/ui/*": ["../../packages/ui/src/components/*"],
      "@/*": ["./src/*", "../web/src/*"],
      "@cubeforge/hardware-hal": ["./src/hardware-hal-override.ts"]
    }
  },
  "include": ["src", "../web/src"],
  // PWA-only modules, excluded because they import `virtual:pwa-register` — a
  // module only vite-plugin-pwa declares, and desktop has no such dependency
  // (the web project resolves it via `"types": ["vite-plugin-pwa/client"]` in
  // apps/web/tsconfig.app.json).
  //
  // The desktop app runs no service worker, so nothing in its module graph
  // reaches either file:
  //   · ../web/src/main.tsx           — the PWA entry; desktop has its own
  //                                     src/main.tsx and never loads this one.
  //   · ../web/src/boot/appUpdate.ts  — the SW update flow; its only consumer
  //                                     is web/src/main.tsx (initAppUpdate).
  // Both stay fully typechecked by the web project, which owns them.
  "exclude": ["../web/src/main.tsx", "../web/src/boot/appUpdate.ts"]
}
