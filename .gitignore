# Scratch/experiment area: track only the scripts (pipeline + tooling) so
# convention changes are visible in git; raw data, generated JSONs, logs,
# backups and loose files stay local.
pruebas/*
!pruebas/scripts/
pruebas/scripts/__pycache__/
.freebuff/
.junie/
Thumbs.db

# Tauri / Rust desktop
**/src-tauri/target/
**/src-tauri/bundle/

.github/hooks/
.github/skills/
.github/agents/
.impeccable/

# Husky hooks internals (auto-generated by the `prepare` script)
.husky/_
# API reference generada por TypeDoc (se regenera con `pnpm docs:api`, no se edita)
/docs/api/

# Generated at build time by apps/web/scripts/gen-version-json.mjs (contains the
# build SHA + timestamp, changes on every build — never commit it).
apps/web/public/version.json

# Supabase CLI state (regenerated by link/login)
supabase/.temp/
# Scratch file that `supabase/validation/run.sh` builds and deletes per suite
/.validation-run.sql
