{
  "name": "cubeforge-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "commit": "czg",
    "prepare": "husky",
    "dev": "turbo run dev --concurrency 15",
    "lint": "turbo run lint",
    "lint:lines": "node scripts/lint-lines.cjs",
    "knip": "knip",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "turbo run typecheck",
    "typecheck:all": "tsc --noEmit -p tsconfig.json",
    "typecheck:watch": "tsc --noEmit -p tsconfig.json --watch",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "docs:api": "typedoc",
    "release": "pnpm build && changeset publish"
  },
  "config": {
    "commitizen": {
      "path": "czg"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@vitest/coverage-v8": "^3.0.5",
    "czg": "^1.9.4",
    "eslint": "^10.7.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.6",
    "knip": "^6.31.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.4",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5"
  }
}
