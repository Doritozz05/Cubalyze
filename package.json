{
  "name": "cubeforge-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:lines": "echo \"TDD-0006: verify files <300 lines. Run manually: find packages apps -name '*.ts' -o -name '*.tsx' | xargs wc -l | sort -rn | head -20\"",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "turbo run typecheck",
    "typecheck:all": "tsc --noEmit -p tsconfig.json",
    "typecheck:watch": "tsc --noEmit -p tsconfig.json --watch",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "turbo": "^2.10.4",
    "vitest": "^3.0.5"
  }
}
