{
  "name": "cubeforge-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "turbo": "^2.10.4",
    "vitest": "^3.0.5"
  }
}
