flowchart LR
    subgraph Apps["Apps"]
        web["apps/web (React PWA)"]
        desktop["apps/desktop (Tauri shell)"]
    end

    subgraph Data["Datos y estado"]
        database["@cubeforge/database<br/>(SQLite WASM/OPFS + repos)"]
