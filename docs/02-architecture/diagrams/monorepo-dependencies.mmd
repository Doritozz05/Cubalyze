        statistics["@cubeforge/statistics"]
    end

    subgraph Domain["Dominio"]
        training["@cubeforge/training<br/>(SRS/FSRS-4)"]
        analysis["@cubeforge/analysis-engine<br/>(pipeline versionado)"]
        algodb["@cubeforge/algorithm-db<br/>(catálogo + seed)"]
        hal["@cubeforge/hardware-hal<br/>(HAL + adaptadores)"]
        timer["@cubeforge/timer-engine"]
        gan["@cubeforge/gan-protocol<br/>(BLE cifrado)"]
    end

    subgraph Core["Núcleo"]
        mathcore["@cubeforge/math-core"]
        solver["@cubeforge/solver-engine<br/>(min2phase)"]
        cube3d["@cubeforge/cube-3d-engine<br/>(Three.js)"]
        types["@cubeforge/types"]
    end

    subgraph UI["UI"]
        ui["@cubeforge/ui (kit Radix)"]
        identicon["@cubeforge/identicon (CubeMark)"]
    end

