    database --> models
    database --> types
    state --> algodb
    state --> types
    models --> algodb
    models --> types

    %% Apps
    web --> algodb
    web --> analysis
    web --> cube3d
    web --> database
    web --> hal
    web --> identicon
    web --> mathcore
    web --> solver
