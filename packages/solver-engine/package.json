{
  "name": "@cubalyze/solver-engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "CubeForge Solver Engine — scramble generation and optimal solving via min2phase WASM",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pyraminx": {
      "types": "./dist/pyraminx.d.ts",
      "import": "./dist/pyraminx.js",
      "require": "./dist/pyraminx.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cubalyze/math-core": "workspace:*",
    "min2phase.js": "^0.0.4"
  },
  "devDependencies": {
    "@cubalyze/config-typescript": "workspace:*",
    "tsup": "^8.3.6",
    "typescript": "~6.0.2",
    "vitest": "^3.0.5"
  }
}
