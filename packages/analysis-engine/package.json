{
  "name": "@cubalyze/analysis-engine",
  "version": "0.2.0",
  "private": true,
  "description": "Real-time analysis pipeline for CubeForge — timeline tracking, phase recognition, and metric computation",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cubalyze/algorithm-db": "workspace:*",
    "@cubalyze/math-core": "workspace:*",
    "@cubalyze/solver-engine": "workspace:*",
    "@cubalyze/statistics": "workspace:*",
    "@cubalyze/types": "workspace:*"
  },
  "devDependencies": {
    "@cubalyze/config-typescript": "workspace:*",
    "tsup": "^8.0.1",
    "typescript": "~6.0.2",
    "vitest": "^3.0.5"
  }
}
