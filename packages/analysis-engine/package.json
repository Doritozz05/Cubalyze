{
  "name": "@cubeforge/analysis-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time analysis pipeline for CubeForge — timeline tracking, phase recognition, and metric computation",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --clean",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@cubeforge/math-core": "workspace:*",
    "@cubeforge/types": "workspace:*"
  },
  "devDependencies": {
    "@cubeforge/config-typescript": "workspace:*",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
