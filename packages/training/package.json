{
  "name": "@cubeforge/training",
  "version": "0.2.0",
  "private": true,
  "description": "Core training engine for CubeForge — exercise definitions, session engine, progress tracking",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cubeforge/algorithm-db": "workspace:*",
    "@cubeforge/solver-engine": "workspace:*",
    "@cubeforge/timer-engine": "workspace:*"
  },
  "devDependencies": {
    "@cubeforge/config-eslint": "workspace:*",
    "@cubeforge/math-core": "workspace:*",
    "@cubeforge/config-typescript": "workspace:*",
    "eslint": "^10.7.0",
    "typescript": "~6.0.2",
    "tsup": "^8.0.0",
    "vitest": "^3.0.5"
  }
}
