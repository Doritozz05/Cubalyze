{
  "name": "@cubeforge/timer-engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@cubeforge/config-eslint": "workspace:*",
    "@cubeforge/config-typescript": "workspace:*",
    "eslint": "^10.7.0",
    "typescript": "^5.7.3",
    "tsup": "^8.0.0",
    "vitest": "^3.0.5"
  }
}
