{
  "name": "@cubeforge/gan-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GAN Smart Cube and Smart Timer Protocol Parser and Decrypter",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "aes-js": "^3.1.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@cubeforge/config-eslint": "workspace:*",
    "@cubeforge/config-typescript": "workspace:*",
    "@types/aes-js": "^3.1.4",
    "@types/web-bluetooth": "^0.0.21",
    "eslint": "^10.7.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

