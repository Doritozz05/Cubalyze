{
  "name": "@cubeforge/cube-3d-engine",
  "version": "1.0.0",
  "description": "Core 3D Engine for CubeForge using Three.js and Web Workers",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./worker": {
      "import": "./dist/workers/EngineWorker.mjs",
      "require": "./dist/workers/EngineWorker.js",
      "types": "./dist/workers/EngineWorker.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/workers/EngineWorker.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts src/workers/EngineWorker.ts --format esm,cjs --watch",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@cubeforge/math-core": "workspace:*",
    "@cubeforge/types": "workspace:*",
    "comlink": "^4.4.1",
    "rxjs": "^7.8.1",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.0.5"
  }
}
