{
  "name": "@cubeforge/cube-3d-engine",
  "version": "0.1.0",
  "description": "Core 3D Engine for CubeForge using Three.js and Web Workers",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/workers/EngineWorker.d.ts",
      "import": "./dist/workers/EngineWorker.mjs",
      "require": "./dist/workers/EngineWorker.js"
    },
    "./skins": {
      "types": "./dist/styles/cubeSkins.d.ts",
      "import": "./dist/styles/cubeSkins.mjs",
      "require": "./dist/styles/cubeSkins.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/workers/EngineWorker.ts src/styles/cubeSkins.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts src/workers/EngineWorker.ts src/styles/cubeSkins.ts --format esm,cjs --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cubeforge/math-core": "workspace:*",
    "@cubeforge/types": "workspace:*",
    "comlink": "^4.4.1",
    "rxjs": "^7.8.1",
    "three": "^0.185.1",
    "three-stdlib": "^2.28.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "tsup": "^8.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
