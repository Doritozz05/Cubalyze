{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    // TS 6.0 deprecates `baseUrl` (error TS5101); tsup injects it into the dts build.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*"]
}
