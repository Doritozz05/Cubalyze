{
  "name": "@cubeforge/types",
  "version": "0.2.0",
  "private": true,
  "description": "Shared type definitions for the CubeForge platform",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@cubeforge/config-typescript": "workspace:*",
    "tsup": "^8.3.6",
    "typescript": "~6.0.2"
  }
}
