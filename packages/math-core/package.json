{
  "name": "@cubeforge/math-core",
  "version": "1.0.0",
  "description": "Mathematical core for Rubik's Cube parsing and permutation",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cubeforge/types": "workspace:*",
    "min2phase.js": "^0.0.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cubeforge/config-typescript": "workspace:*",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
