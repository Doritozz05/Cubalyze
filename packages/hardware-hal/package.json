{
  "name": "@cubalyze/hardware-hal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Hardware Abstraction Layer for Smart Cubes and Timers",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@cubalyze/gan-protocol": "workspace:*",
    "@cubalyze/types": "workspace:*",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@cubalyze/config-eslint": "workspace:*",
    "@cubalyze/config-typescript": "workspace:*",
    "@types/audioworklet": "^0.0.100",
    "@types/web-bluetooth": "^0.0.20",
    "eslint": "^10.7.0",
    "tsup": "^8.3.6",
    "typescript": "~6.0.2",
    "vitest": "^3.0.5"
  }
}
